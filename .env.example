# Developer Quality & Observability Hub
HUB_BIND_ADDRESS=127.0.0.1
HUB_API_PORT=18080
HUB_WEB_PORT=18000
PROJECTS_ROOT=/absolute/path/to/projects
HUB_DATA_DIR=/app/data
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_SECONDS=1800

# M0 local authentication. Generate a random value outside Git, for example:
# openssl rand -hex 32
HUB_AUTH_TOKEN=
HUB_AUTH_ACTOR_ID=
HUB_AUTH_ROLE=ADMIN
HUB_ALLOWED_ORIGINS=http://127.0.0.1:18000,http://localhost:18000,http://127.0.0.1:18080,http://localhost:18080
HUB_REQUEST_BODY_LIMIT_BYTES=1048576
HUB_RATE_LIMIT_MAX_MUTATIONS=60
HUB_RATE_LIMIT_WINDOW_MS=60000
HUB_UPSTREAM_TIMEOUT_MS=5000
HUB_UPSTREAM_RESPONSE_LIMIT_BYTES=1048576
HUB_ALLOWED_UPSTREAM_ORIGINS=
# Only supported in native, loopback-bound mode. Compose always forces this off.
HUB_PRIVILEGED_EXECUTION_ENABLED=0
HUB_RUNTIME_TIMEOUT_MS=1800000
HUB_PROCESS_OUTPUT_LIMIT_BYTES=2097152

# SonarQube. Keep tokens in your shell or secret manager, not in Git.
SONAR_HOST_URL=http://host.docker.internal:9000
SONAR_TOKEN=
SONARQUBE_PORT=9000
SONAR_POSTGRES_USER=sonar
SONAR_POSTGRES_PASSWORD=
SONAR_POSTGRES_DB=sonarqube

# Hub infrastructure.
HUB_POSTGRES_USER=hub
HUB_POSTGRES_PASSWORD=
HUB_POSTGRES_DB=qualityhub

# Grafana starts without an initial admin by default. To enable one, provide both
# values externally and set GRAFANA_DISABLE_INITIAL_ADMIN_CREATION=false.
GRAFANA_DISABLE_INITIAL_ADMIN_CREATION=true
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Jenkins fails closed until both values are supplied externally.
JENKINS_ADMIN_ID=
JENKINS_ADMIN_PASSWORD=
JENKINS_PORT=18082

# Observability external ports.
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
LOKI_PORT=13100
TEMPO_PORT=13200
OTEL_GRPC_PORT=14317
OTEL_HTTP_PORT=14318
ALERTMANAGER_PORT=19093
BLACKBOX_PORT=19115
CADVISOR_PORT=18081
